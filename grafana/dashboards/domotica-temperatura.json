          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  \"time\" AS \"time\",\n  trim(state)::numeric AS \"Temperatura\"\nFROM public.ltss\nWHERE entity_id = '${sensor}'\n  AND state IS NOT NULL\n  AND state <> 'unavailable'\n  AND trim(state) ~ '^-?[0-9]+(\\.[0-9]+)?$'\n  AND $__timeFilter(\"time\")\nORDER BY \"time\"",
