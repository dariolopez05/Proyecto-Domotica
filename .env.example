# Copia este archivo a .env y rellena con tus credenciales
# NO comitees el archivo .env a git (está en .gitignore)

# Configuración de conexión a PostgreSQL
# DB_NAME = nombre de la base de datos (no el esquema "public"). Ej.: postgres, homeassistant.
# La consulta del proyecto usa la tabla ltss (esquema public por defecto).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

